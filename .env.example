# 실행 환경: development | test | production
NODE_ENV=development
PORT=3000

# Postgres (로컬 Homebrew 예: postgres://<OS 사용자>@localhost:5432/cassette_dev)
DATABASE_URL=postgres://cassette:cassette@localhost:5432/cassette_dev
# Redis (BullMQ 변환 큐)
REDIS_URL=redis://localhost:6379
BULLMQ_PREFIX=cassette

# 녹음 파일 저장소: local(개발: 디스크 + API 서명 URL, MinIO 없이) | s3(운영: MinIO / R2)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage

# S3 호환 저장소 (STORAGE_DRIVER=s3일 때)
S3_ENDPOINT=http://localhost:9000
# 앱이 presigned URL로 접속할 주소 (S3_ENDPOINT와 다를 때만. 예: https://files.cassette.app)
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=cassette
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=false

# 테이프 소리 변환: passthrough(개발: ffmpeg 없이 원본 그대로) | real(운영)
# 실제 테이프 소리를 들으려면 `brew install ffmpeg` 후 real
FFMPEG_MODE=passthrough
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# 링크 주소·로컬 저장소 URL의 앞부분. 개발에서 실기기로 붙으면 맥의 IP로 (예: http://192.168.0.10:3000)
PUBLIC_BASE_URL=http://localhost:3000
# 유니버설 링크 / 앱 링크 (비우면 해당 파일은 404)
APPLE_APP_ID=
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=

# JWT. 운영에서는 `openssl rand -base64 48` 등으로 만든 32자 이상의 값
JWT_SECRET=change-me-to-a-long-random-string-32chars+
# 저장하는 Apple refresh token 암호화 키 (32바이트 base64: `openssl rand -base64 32`). 운영 필수, 개발은 비워 두면 개발용 기본값
TOKEN_ENCRYPTION_KEY=
# access token 수명(초), refresh token 수명(초)
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=5184000

# 카카오 앱 ID (내 애플리케이션 > 앱 설정 > 앱 키 화면의 앱 ID). 운영에서 필수
KAKAO_APP_ID=
# Apple identity token의 aud로 허용할 값(앱 번들 ID, 웹용 Service ID). 쉼표로 구분. 운영에서 필수
APPLE_CLIENT_IDS=

# 가입 선물 크레딧
SIGNUP_GIFT_CREDITS=10

# 강제 업데이트 (GET /api/app-version)
APP_MIN_VERSION_IOS=1.0.0
APP_LATEST_VERSION_IOS=1.0.0
APP_STORE_URL_IOS=https://apps.apple.com/app/id0000000000
APP_MIN_VERSION_ANDROID=1.0.0
APP_LATEST_VERSION_ANDROID=1.0.0
APP_STORE_URL_ANDROID=https://play.google.com/store/apps/details?id=app.cassette

# ---- docker compose 운영 전용 (docker compose --env-file .env.production) ----
# DATABASE_URL, REDIS_URL은 compose가 컨테이너 주소로 덮어쓴다
POSTGRES_USER=cassette
POSTGRES_PASSWORD=
POSTGRES_DB=cassette
MINIO_ROOT_USER=cassette
MINIO_ROOT_PASSWORD=
# 운영에서는 위 S3_PUBLIC_ENDPOINT에 Cloudflare Tunnel로 공개한 MinIO 주소를 꼭 채운다

# Cloudflare Tunnel 토큰 (Zero Trust > Networks > Tunnels > 커넥터 설치 명령의 토큰)
TUNNEL_TOKEN=

# 백업 (docs/deploy.md). cron은 UTC 기준
BACKUP_DIR=./backups
PG_BACKUP_CRON=0 19 * * *
PG_BACKUP_KEEP=14
OFFSITE_BACKUP_CRON=30 19 * * *
# 외부 복제 대상 (Cloudflare R2: provider Cloudflare, endpoint https://<계정 ID>.r2.cloudflarestorage.com
#                Backblaze B2: provider Other, endpoint https://s3.<리전>.backblazeb2.com). 비우면 외부 복제를 건너뛴다
OFFSITE_PROVIDER=Cloudflare
OFFSITE_ENDPOINT=
OFFSITE_REGION=auto
OFFSITE_BUCKET=
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=
OFFSITE_POSTGRES_RETENTION=30d
OFFSITE_DELETED_RETENTION=30d

# ---- 푸시 (FCM HTTP v1). 없으면 로그만 ----
FCM_SERVICE_ACCOUNT_JSON=

# ---- 결제 · 광고 (없으면 POST /api/billing/iap는 503, 개발은 POST /api/dev/credits) ----
APPLE_BUNDLE_ID=
APPLE_APP_APPLE_ID=
APPLE_IAP_ALLOW_SANDBOX=true
# Apple 루트 인증서 폴더 (비우면 apple.com에서 받는다)
APPLE_ROOT_CERTS_DIR=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Play RTDN Pub/Sub 푸시 구독의 audience (예: https://<도메인>/api/billing/google/rtdn)
GOOGLE_RTDN_AUDIENCE=

# ---- 탈퇴 시 소셜 연결 해제 (없으면 건너뛴다) ----
KAKAO_ADMIN_KEY=
APPLE_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
# .p8 내용. 한 줄로 적을 때는 줄바꿈을 \n으로
APPLE_SIGN_IN_PRIVATE_KEY=
